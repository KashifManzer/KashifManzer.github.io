---

import { profile, socials } from "../data/profile";
import geistFont from "@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url";
import "../styles/tokens.css";

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  noindex?: boolean;
  isProfile?: boolean;
}
const { title, description, canonicalPath = Astro.url.pathname, noindex = false, isProfile = false } = Astro.props;
const canonical = new URL(canonicalPath, Astro.site);
const socialImage = new URL('/social-card.png', Astro.site);
const person = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  url: canonical.href,
  mainEntity: {
    "@type": "Person", "@id": `${profile.site}/#person`,
    name: profile.name, jobTitle: profile.role, url: profile.site,
    description: profile.description, sameAs: socials.map(social => social.href),
  },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#050a12" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {!noindex && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href={geistFont} as="font" type="font/woff2" crossorigin />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Kashif Manzer" />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Kashif Manzer — Backend & Infrastructure Engineer" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:creator" content="@kashif_manzer" />
    <meta name="twitter:image" content={socialImage} />
    {isProfile && <script type="application/ld+json" is:inline set:html={JSON.stringify(person)} />}
  </head>
  <body>
    <slot />
  </body>
</html>
