---
import { socials } from '../data/profile';
---
<section id="contact" class="contact" aria-labelledby="contact-title" tabindex="-1">
  <h2 id="contact-title" class="sr-only">Connect with Kashif</h2>
  <picture class="contact-poster" aria-hidden="true"><source media="(max-width:700px)" srcset="/direction/contact-mobile.webp" /><img src="/direction/contact-desktop.webp" width="1440" height="900" alt="" loading="lazy" /></picture>
  <nav class="social-links" aria-label="Connect with Kashif">
    {socials.map(social => <a data-social={social.id} href={social.href} target="_blank" rel="noopener noreferrer me" aria-label={`${social.name} (opens in a new tab)`}>
      <img class="asteroid-image" src={`/social/asteroid-${social.id}.webp`} width="320" height="320" alt="" loading="lazy" />
      <span class="social-name">{social.name}<span aria-hidden="true"> ↗</span></span>
    </a>)}
  </nav>
</section>
<style>
  .contact { position:relative; min-height:100svh; }
  .contact-poster { position:absolute; inset:0; left:-7vw; width:100vw; height:100svh; z-index:-1; opacity:.28; }
  .contact-poster img { width:100%; height:100%; object-fit:cover; }
  .social-links { min-height:100svh; display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); align-content:center; gap:24px; }
  .social-links a { position:relative; display:flex; min-width:44px; min-height:44px; flex-direction:column; align-items:center; justify-content:center; color:#f4f6f8; text-decoration:none; cursor:pointer; border-radius:12px; }
  .asteroid-image { display:block; width:100%; height:auto; object-fit:contain; }
  .social-name { padding:8px 12px; font-size:14px; white-space:nowrap; background:#0b121b; border-radius:4px; }
  .social-links a:hover .social-name { text-decoration:underline; text-underline-offset:4px; }
  .social-links a:focus-visible { outline:2px solid #fff; outline-offset:5px; }
  :global([data-graphics="ready"]:not(.reduced)) .contact-poster { visibility:hidden; }
  :global([data-graphics="ready"]:not(.reduced)) .social-links { display:block; min-height:100svh; }
  :global([data-graphics="ready"]:not(.reduced)) .social-links a { position:fixed; left:var(--rock-x); top:var(--rock-y); width:var(--rock-w); height:var(--rock-h); z-index:8; visibility:hidden; }
  :global([data-graphics="ready"]:not(.reduced)[data-contact-targets="true"]) .social-links a { visibility:visible; }
  :global([data-graphics="ready"]:not(.reduced)) .asteroid-image { display:none; }
  :global([data-graphics="ready"]:not(.reduced)) .social-name { position:absolute; top:100%; margin-top:8px; opacity:0; }
  :global([data-graphics="ready"]:not(.reduced)) a:hover .social-name,
  :global([data-graphics="ready"]:not(.reduced)) a:focus-visible .social-name { opacity:1; }
  @media(max-aspect-ratio:1) { .social-links { grid-template-columns:repeat(2,minmax(0,1fr)); gap:36px 20px; } }
  @media(max-width:700px) { .contact-poster { left:-26px; } }
</style>
<script>
  // A failed capture leaves a named, native link; never a broken-image placeholder.
  for (const image of document.querySelectorAll<HTMLImageElement>('.asteroid-image')) {
    const hide = () => { image.hidden = true; image.style.display = 'none'; };
    image.addEventListener('error', hide, { once:true });
    if (image.complete && !image.naturalWidth) hide();
  }
</script>
